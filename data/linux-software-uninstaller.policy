<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Linux Software Uninstaller</vendor>
  <icon_name>linux-software-uninstaller</icon_name>
  <action id="linux-software-uninstaller.helper">
    <description>Uninstall software and remove leftovers</description>
    <description xml:lang="pl">Odinstalowywanie programów i usuwanie pozostałości</description>
    <message>Authentication is required to uninstall software or remove system files</message>
    <message xml:lang="pl">Linux Software Uninstaller potrzebuje hasła administratora, aby odinstalować programy lub usunąć pliki systemowe</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/linux-software-uninstaller/lsu-helper</annotate>
  </action>
</policyconfig>
